{
  "name": "acsp",
  "version": "0.1.0",
  "private": true,
  "description": "ACSP — Agent Continuity & Session Protocol: a browser-accessible continuity substrate for independent AI sessions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harness": "tsx harness/cli.ts",
    "serve:local": "tsx harness/serve.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "vercel-build": "ACSP_MIGRATE_OPTIONAL=1 tsx scripts/migrate.ts && next build"
  },
  "dependencies": {
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
