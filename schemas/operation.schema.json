{
  "$id": "urn:acsp:schema:operation",
  "title": "ACSP/0.2 operation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "acsp.operation/0.2"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op-[0-9A-HJKMNP-TV-Z]{16}$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "operation_type": {
      "type": "string"
    },
    "definition_version": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "agent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "human",
            "system"
          ]
        }
      },
      "required": [
        "session_id",
        "agent_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "identity_assurance": {
      "type": "string",
      "enum": [
        "capability",
        "asserted"
      ]
    },
    "authority": {
      "type": "object",
      "properties": {
        "via": {
          "type": "string",
          "enum": [
            "capability",
            "none"
          ]
        },
        "capability_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "capability_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "owner",
                "delegation"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "via",
        "capability_id",
        "capability_kind",
        "scopes"
      ],
      "additionalProperties": false
    },
    "requested_by": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "agent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "human",
            "system"
          ]
        },
        "identity_assurance": {
          "type": "string",
          "enum": [
            "capability",
            "asserted"
          ]
        }
      },
      "required": [
        "session_id",
        "agent_id",
        "kind",
        "identity_assurance"
      ],
      "additionalProperties": false
    },
    "executed_by": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "agent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "human",
            "system"
          ]
        },
        "identity_assurance": {
          "type": "string",
          "enum": [
            "capability",
            "asserted"
          ]
        }
      },
      "required": [
        "session_id",
        "agent_id",
        "kind",
        "identity_assurance"
      ],
      "additionalProperties": false
    },
    "on_behalf_of": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
            },
            "agent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "agent",
                "human",
                "system"
              ]
            },
            "identity_assurance": {
              "type": "string",
              "enum": [
                "capability",
                "asserted"
              ]
            }
          },
          "required": [
            "session_id",
            "agent_id",
            "kind",
            "identity_assurance"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "expected_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "transition": {
      "type": "object",
      "properties": {
        "from_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "to_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state_before": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_after": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "operation": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version",
              "operation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "from_version",
        "to_version",
        "state_before",
        "state_after",
        "events"
      ],
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "parent_operation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^op-[0-9A-HJKMNP-TV-Z]{16}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^op-[0-9A-HJKMNP-TV-Z]{16}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "causation_source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "actor",
                "derived"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "correlation_id": {
          "type": "string"
        }
      },
      "required": [
        "parent_operation_id",
        "causation_id",
        "causation_source",
        "correlation_id"
      ],
      "additionalProperties": false
    },
    "executed": {
      "type": "boolean",
      "const": true
    },
    "result": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "links": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "operation_id",
    "resource_id",
    "sequence",
    "operation_type",
    "definition_version",
    "protocol_version",
    "actor",
    "identity_assurance",
    "authority",
    "requested_by",
    "executed_by",
    "on_behalf_of",
    "proposal_id",
    "payload",
    "expected_version",
    "idempotency_key",
    "request_hash",
    "transition",
    "lineage",
    "executed",
    "result",
    "created_at"
  ],
  "additionalProperties": false,
  "description": "acsp.operation/0.2"
}
