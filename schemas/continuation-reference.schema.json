{
  "$id": "urn:acsp:schema:continuation-reference",
  "title": "ACSP/0.2 continuation-reference",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "acsp.continuation-reference/0.2"
    },
    "href": {
      "type": "string",
      "format": "uri"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{12}$"
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^op-[0-9A-HJKMNP-TV-Z]{16}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "state_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "href",
    "resource_id",
    "operation_id",
    "version",
    "state_sha256",
    "correlation_id"
  ],
  "additionalProperties": false,
  "description": "acsp.continuation-reference/0.2"
}
