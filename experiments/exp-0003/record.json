 "operational_definitions": {
  "communication through state transitions": "Each session's only input from the previous session is a URL identifying persisted state; each session's only output to the next is a URL returned by an ACSP operation; everything else a session learns comes from GET requests to the service.",
  "independent": "Separate OS process, separate private directory, no shared memory, no transcript of any other session, no credential it was not explicitly given.",
  "verify": "Recompute: the operation chain (state_before = previous state_after, from_version = previous to_version, parent pointers), the current operational-state digest from GET /state, and every checkpoint hash from its snapshot; validate records against the published schemas.",
  "leak": "Any occurrence of the substring acsp_cap_ in what the orchestrator passes to B or C (argv, environment, stdin), or in any response body B or C receives."
 },
