# ── Required in production ──────────────────────────────────────────────
# PostgreSQL connection string. On Vercel use your provider's *pooled* URL
# (Neon: the "-pooler" host; Supabase: the transaction pooler on port 6543).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ── Optional ────────────────────────────────────────────────────────────
# Absolute public origin used in links (defaults to the request's origin).
# ACSP_PUBLIC_URL=https://acsp.example.com

# If set, `create` requires this value in the request's `create_key` field.
# ACSP_CREATE_KEY=

# Rate limits (per client IP, per hour).
# ACSP_RATE_LIMIT_ANON_PER_HOUR=60
# ACSP_RATE_LIMIT_WRITES_PER_HOUR=1200

# Local development only: when DATABASE_URL is unset outside production,
# an embedded PGlite database is stored here.
# ACSP_PGLITE_DIR=.data/pglite

# Harness / tests against a real Postgres (each run uses a fresh schema).
# ACSP_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/acsp_test

# ── GLASS-LIVE/0.1 derived trace streaming (opt-in) ────────────────
# Generate independently random 32+ byte bearer keys; never commit real values.
# Ingestion can come from Glass APK only after user has approved private streaming.
# Required to enable any private event write or read API:
# GLASS_STREAM_WRITE_KEY=
# GLASS_STREAM_READ_KEY=
# Public GET /glass and GET /api/glass/stream without a room emit only synthetic protocol heartbeat.
# Configure DATABASE_URL and apply db/migrations/0003_glass_trace.sql before using authenticated room endpoints.
